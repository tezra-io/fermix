{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fermix.sh/mobile/protocol.schema.json",
  "title": "Fermix mobile companion protocol JSON header",
  "description": "JSON-header contract inside Noise-encrypted mobile frames. Source of truth: FermixChannels.Mobile.Protocol.",
  "x-protocol-version": 1,
  "x-supported-version-range": {"min": 1, "max": 1},
  "x-frame-format": "uint32be-json-length + json-header + raw-bytes",
  "x-max-json-header-bytes": 4096,
  "x-max-raw-chunk-bytes": 61440,
  "x-max-plaintext-bytes": 65519,
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["v", "t", "seq"],
      "properties": {
        "v": {"type": "integer", "minimum": 1},
        "t": {"type": "string", "minLength": 1},
        "seq": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
      }
    },
    "clientEvent": {
      "type": "object",
      "required": ["v", "t", "seq"],
      "properties": {
        "t": {"enum": [
          "hello", "msg", "attach_begin", "attach_chunk", "attach_end", "command",
          "history_pull", "media_fetch", "push_register", "ack", "read_state",
          "pair_request", "unpair", "ping"
        ]}
      },
      "allOf": [
        {"if": {"properties": {"t": {"const": "hello"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/hello"}},
        {"if": {"properties": {"t": {"const": "msg"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/msg"}},
        {"if": {"properties": {"t": {"const": "attach_begin"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/attach_begin"}},
        {"if": {"properties": {"t": {"const": "attach_chunk"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/attach_chunk"}},
        {"if": {"properties": {"t": {"const": "attach_end"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/attach_end"}},
        {"if": {"properties": {"t": {"const": "command"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/command"}},
        {"if": {"properties": {"t": {"const": "history_pull"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/history_pull"}},
        {"if": {"properties": {"t": {"const": "media_fetch"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/media_fetch"}},
        {"if": {"properties": {"t": {"const": "push_register"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/push_register"}},
        {"if": {"properties": {"t": {"const": "ack"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/ack"}},
        {"if": {"properties": {"t": {"const": "read_state"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/read_state"}},
        {"if": {"properties": {"t": {"const": "pair_request"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/pair_request"}},
        {"if": {"properties": {"t": {"const": "unpair"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/unpair"}},
        {"if": {"properties": {"t": {"const": "ping"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/ping"}}
      ]
    },
    "serverEvent": {
      "type": "object",
      "required": ["v", "t", "seq"],
      "properties": {
        "t": {"enum": [
          "hello_ack", "accepted", "attach_status", "turn_started", "text_delta",
          "tool_event", "text_done", "media_begin", "media_chunk", "media_end",
          "turn_error", "reaction", "approval", "approval_resolved", "link_preview",
          "read_state", "history_page", "notice", "pair_approved", "pair_denied",
          "error", "pong"
        ]}
      },
      "allOf": [
        {"if": {"properties": {"t": {"const": "hello_ack"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/hello_ack"}},
        {"if": {"properties": {"t": {"const": "accepted"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/accepted"}},
        {"if": {"properties": {"t": {"const": "attach_status"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/attach_status"}},
        {"if": {"properties": {"t": {"const": "turn_started"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/turn_started"}},
        {"if": {"properties": {"t": {"const": "text_delta"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/text_delta"}},
        {"if": {"properties": {"t": {"const": "tool_event"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/tool_event"}},
        {"if": {"properties": {"t": {"const": "text_done"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/text_done"}},
        {"if": {"properties": {"t": {"const": "media_begin"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/media_begin"}},
        {"if": {"properties": {"t": {"const": "media_chunk"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/media_chunk"}},
        {"if": {"properties": {"t": {"const": "media_end"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/media_end"}},
        {"if": {"properties": {"t": {"const": "turn_error"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/turn_error"}},
        {"if": {"properties": {"t": {"const": "reaction"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/reaction"}},
        {"if": {"properties": {"t": {"const": "approval"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/approval"}},
        {"if": {"properties": {"t": {"const": "approval_resolved"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/approval_resolved"}},
        {"if": {"properties": {"t": {"const": "link_preview"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/link_preview"}},
        {"if": {"properties": {"t": {"const": "read_state"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/read_state"}},
        {"if": {"properties": {"t": {"const": "history_page"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/history_page"}},
        {"if": {"properties": {"t": {"const": "notice"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/notice"}},
        {"if": {"properties": {"t": {"const": "pair_approved"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/pair_approved"}},
        {"if": {"properties": {"t": {"const": "pair_denied"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/pair_denied"}},
        {"if": {"properties": {"t": {"const": "error"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/error"}},
        {"if": {"properties": {"t": {"const": "pong"}}, "required": ["t"]}, "then": {"$ref": "#/$defs/pong"}}
      ]
    },
    "hello": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["v", "t", "seq", "device_id", "app_version", "last_server_seq", "protocol_v"],
      "properties": {
        "t": {"const": "hello"}, "device_id": {"type": "string", "minLength": 1},
        "app_version": {"type": "string", "minLength": 1},
        "last_server_seq": {"type": "integer", "minimum": 0},
        "protocol_v": {"type": "integer", "minimum": 1}
      }
    },
    "msg": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["v", "t", "seq", "client_msg_id", "profile_id", "text", "attach_ids"],
      "properties": {
        "t": {"const": "msg"}, "client_msg_id": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1}, "text": {"type": "string"},
        "attach_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "attach_begin": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["v", "t", "seq", "attach_id", "kind", "mime", "size_bytes", "sha256"],
      "properties": {
        "t": {"const": "attach_begin"}, "attach_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1}, "mime": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0}, "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "attach_chunk": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "x-raw-bytes": true,
      "required": ["v", "t", "seq", "attach_id", "index"],
      "properties": {"t": {"const": "attach_chunk"}, "attach_id": {"type": "string", "minLength": 1}, "index": {"type": "integer", "minimum": 0}}
    },
    "attach_end": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["v", "t", "seq", "attach_id", "sha256"],
      "properties": {"t": {"const": "attach_end"}, "attach_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}
    },
    "command": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["v", "t", "seq", "client_msg_id", "profile_id", "name"],
      "properties": {"t": {"const": "command"}, "client_msg_id": {"type": "string", "minLength": 1}, "profile_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "args": {"type": "string"}}
    },
    "history_pull": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["v", "t", "seq", "profile_id", "after_seq", "limit"],
      "properties": {"t": {"const": "history_pull"}, "profile_id": {"type": "string", "minLength": 1}, "after_seq": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 200}}
    },
    "media_fetch": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "ref"],
      "properties": {"t": {"const": "media_fetch"}, "ref": {"type": "string", "minLength": 1}}
    },
    "push_register": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "apns_token", "environment"],
      "properties": {"t": {"const": "push_register"}, "apns_token": {"type": "string", "minLength": 1}, "environment": {"enum": ["development", "production"]}}
    },
    "ack": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "server_seq"],
      "properties": {"t": {"const": "ack"}, "server_seq": {"type": "integer", "minimum": 0}}
    },
    "read_state": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "profile_id", "read_up_to_seq"],
      "properties": {"t": {"const": "read_state"}, "profile_id": {"type": "string", "minLength": 1}, "read_up_to_seq": {"type": "integer", "minimum": 0}}
    },
    "pair_request": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "device_name", "model", "app_version"],
      "properties": {"t": {"const": "pair_request"}, "device_name": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "app_version": {"type": "string", "minLength": 1}}
    },
    "unpair": {"allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq"], "properties": {"t": {"const": "unpair"}}},
    "ping": {"allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq"], "properties": {"t": {"const": "ping"}}},
    "hello_ack": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["v", "t", "seq", "session_id", "min_version", "max_version", "profiles", "candidates", "history_head_seq", "read_up_to_seq", "caps"],
      "properties": {
        "t": {"const": "hello_ack"}, "session_id": {"type": "string", "minLength": 1},
        "min_version": {"type": "integer", "minimum": 1}, "max_version": {"type": "integer", "minimum": 1},
        "profiles": {"type": "array", "items": {"type": "object"}}, "candidates": {"type": "array", "items": {"type": "object"}},
        "history_head_seq": {"type": "integer", "minimum": 0}, "read_up_to_seq": {"type": "integer", "minimum": 0}, "caps": {"type": "object"}
      }
    },
    "accepted": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "client_msg_id", "duplicate"],
      "properties": {"t": {"const": "accepted"}, "client_msg_id": {"type": "string", "minLength": 1}, "duplicate": {"type": "boolean"}}
    },
    "attach_status": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "attach_id", "status"],
      "properties": {"t": {"const": "attach_status"}, "attach_id": {"type": "string", "minLength": 1}, "status": {"enum": ["upload", "present"]}}
    },
    "turn_started": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "profile_id", "turn_id", "in_reply_to"],
      "properties": {"t": {"const": "turn_started"}, "profile_id": {"type": "string", "minLength": 1}, "turn_id": {"type": "string", "minLength": 1}, "in_reply_to": {"type": "string", "minLength": 1}}
    },
    "text_delta": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "turn_id", "text"],
      "properties": {"t": {"const": "text_delta"}, "turn_id": {"type": "string", "minLength": 1}, "text": {"type": "string"}}
    },
    "tool_event": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "turn_id", "tool", "phase"],
      "properties": {"t": {"const": "tool_event"}, "turn_id": {"type": "string", "minLength": 1}, "tool": {"type": "string", "minLength": 1}, "phase": {"enum": ["start", "stop"]}, "detail": {"type": "string"}}
    },
    "text_done": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "turn_id", "server_seq", "text"],
      "properties": {"t": {"const": "text_done"}, "turn_id": {"type": "string", "minLength": 1}, "server_seq": {"type": "integer", "minimum": 1}, "text": {"type": "string"}}
    },
    "media_begin": {
      "allOf": [{"$ref": "#/$defs/envelope"}],
      "required": ["v", "t", "seq", "ref", "server_seq", "kind", "mime", "size_bytes", "sha256"],
      "properties": {"t": {"const": "media_begin"}, "ref": {"type": "string", "minLength": 1}, "server_seq": {"type": "integer", "minimum": 1}, "kind": {"type": "string", "minLength": 1}, "mime": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "filename": {"type": "string", "minLength": 1}, "caption": {"type": "string", "minLength": 1}}
    },
    "media_chunk": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "x-raw-bytes": true,
      "required": ["v", "t", "seq", "ref", "index"],
      "properties": {"t": {"const": "media_chunk"}, "ref": {"type": "string", "minLength": 1}, "index": {"type": "integer", "minimum": 0}}
    },
    "media_end": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "ref", "sha256"],
      "properties": {"t": {"const": "media_end"}, "ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}
    },
    "turn_error": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "turn_id", "code", "message"],
      "properties": {"t": {"const": "turn_error"}, "turn_id": {"type": "string", "minLength": 1}, "code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}
    },
    "reaction": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "in_reply_to", "emoji"],
      "properties": {"t": {"const": "reaction"}, "in_reply_to": {"type": "string", "minLength": 1}, "emoji": {"type": "string", "minLength": 1}}
    },
    "approval": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "approval_id", "kind", "text", "token", "ttl_s", "approve_command", "deny_command"],
      "properties": {"t": {"const": "approval"}, "approval_id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "detail": {"type": "string"}, "token": {"type": "string", "minLength": 1}, "ttl_s": {"type": "integer", "minimum": 1}, "approve_command": {"type": "string", "minLength": 1, "maxLength": 1024}, "deny_command": {"type": "string", "minLength": 1, "maxLength": 1024}}
    },
    "approval_resolved": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "approval_id", "outcome"],
      "properties": {"t": {"const": "approval_resolved"}, "approval_id": {"type": "string", "minLength": 1}, "outcome": {"enum": ["approved", "denied", "expired"]}}
    },
    "link_preview": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "in_reply_to", "url", "site", "title"],
      "properties": {"t": {"const": "link_preview"}, "in_reply_to": {"type": "integer", "minimum": 0}, "url": {"type": "string", "minLength": 1}, "site": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "description": {"type": "string"}, "image_ref": {"type": "string", "minLength": 1}}
    },
    "history_page": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "profile_id", "messages"],
      "properties": {"t": {"const": "history_page"}, "profile_id": {"type": "string", "minLength": 1}, "messages": {"type": "array", "items": {"type": "object"}}, "next_after_seq": {"type": "integer", "minimum": 0}}
    },
    "notice": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "kind", "text"],
      "properties": {"t": {"const": "notice"}, "kind": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}
    },
    "pair_approved": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "device_id", "candidates", "profiles"],
      "properties": {"t": {"const": "pair_approved"}, "device_id": {"type": "string", "minLength": 1}, "candidates": {"type": "array", "items": {"type": "object"}}, "profiles": {"type": "array", "items": {"type": "object"}}}
    },
    "pair_denied": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "reason"],
      "properties": {"t": {"const": "pair_denied"}, "reason": {"type": "string", "minLength": 1}}
    },
    "error": {
      "allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq", "code", "message"],
      "properties": {"t": {"const": "error"}, "code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "ref_seq": {"type": "integer", "minimum": 1}}
    },
    "pong": {"allOf": [{"$ref": "#/$defs/envelope"}], "required": ["v", "t", "seq"], "properties": {"t": {"const": "pong"}}}
  },
  "anyOf": [
    {"$ref": "#/$defs/clientEvent"},
    {"$ref": "#/$defs/serverEvent"}
  ]
}
