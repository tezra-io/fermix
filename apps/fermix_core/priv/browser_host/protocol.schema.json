{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fermix.sh/browser_host/protocol.schema.json",
  "title": "Fermix browser host protocol",
  "description": "Newline-delimited JSON wire contract between the Fermix daemon and the Fermix app's browser host on browser_host.sock. The app opens it with the handshake and attached; then the daemon sends requests with an id, the app answers each (response), and sends events. Source of truth: FermixCore.BrowserHost.Protocol. See PROTOCOL.md.",
  "x-protocol-version": 1,
  "x-supported-version-range": {
    "min": 1,
    "max": 1
  },
  "x-max-line-bytes": 4194304,
  "x-max-message-chars": 500,
  "x-max-reason-chars": 200,
  "x-max-nodes": 50000,
  "anyOf": [
    {
      "$ref": "#/$defs/hostEvent"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/daemonFrame"
    }
  ],
  "$defs": {
    "hostEvent": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "client_hello",
            "attached",
            "availability",
            "tab.closed",
            "dialog.opened",
            "download.began",
            "download.progress",
            "download.finished",
            "host_stopping"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "client_hello"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/client_hello"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "attached"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/attached"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "availability"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/availability"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "tab.closed"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/tab.closed"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "dialog.opened"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/dialog.opened"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "download.began"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/download.began"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "download.progress"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/download.progress"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "download.finished"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/download.finished"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "host_stopping"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/host_stopping"
          }
        }
      ]
    },
    "daemonFrame": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "server_hello",
            "error",
            "tab.open",
            "tab.navigate",
            "tab.list",
            "tab.focus",
            "tab.close",
            "task.release",
            "page.snapshot",
            "page.screenshot",
            "page.pdf",
            "page.act",
            "page.upload",
            "dialog.resolve",
            "cookies.get",
            "cookies.clear",
            "host.status",
            "host.stop_ack"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "server_hello"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/server_hello"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "error"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/error"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "tab.open"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/tab.open"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "tab.navigate"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/tab.navigate"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "tab.list"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/tab.list"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "tab.focus"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/tab.focus"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "tab.close"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/tab.close"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "task.release"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/task.release"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "page.snapshot"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/page.snapshot"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "page.screenshot"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/page.screenshot"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "page.pdf"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/page.pdf"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "page.act"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/page.act"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "page.upload"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/page.upload"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "dialog.resolve"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/dialog.resolve"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "cookies.get"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/cookies.get"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "cookies.clear"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/cookies.clear"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "host.status"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/host.status"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "host.stop_ack"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/host.stop_ack"
          }
        }
      ]
    },
    "tab.open": {
      "type": "object",
      "description": "Open a new tab for a task on url. With observe, answer once the page has settled and carry it back as `page`, read with `snapshot`'s options. Downloads from the tab and its popups go into download_dir. Refused with cap_reached past task_tab_cap tabs for the task or tab_cap task tabs in all; a popup counts against its opener's owner.",
      "required": [
        "id",
        "type",
        "task_id",
        "url",
        "observe",
        "download_dir",
        "task_tab_cap",
        "tab_cap"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "tab.open"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "observe": {
          "type": "boolean"
        },
        "download_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "task_tab_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "tab_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "snapshot": {
          "$ref": "#/$defs/snapshotOptions"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "observe": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "snapshot"
        ]
      }
    },
    "tab.navigate": {
      "type": "object",
      "description": "Navigate one of the task's tabs to url; observe as tab.open.",
      "required": [
        "id",
        "type",
        "tab_id",
        "url",
        "observe"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "tab.navigate"
        },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "observe": {
          "type": "boolean"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshotOptions"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "observe": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "snapshot"
        ]
      }
    },
    "tab.list": {
      "type": "object",
      "description": "The task's tabs, popups included.",
      "required": [
        "id",
        "type",
        "task_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "tab.list"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "tab.focus": {
      "type": "object",
      "description": "Bring one of the task's tabs to the front of the pane.",
      "required": [
        "id",
        "type",
        "tab_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "tab.focus"
        },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "tab.close": {
      "type": "object",
      "description": "Close one of the task's tabs.",
      "required": [
        "id",
        "type",
        "tab_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "tab.close"
        },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "task.release": {
      "type": "object",
      "description": "The task is over: close every tab it owns and forget their ownership. Idempotent: a second release finds nothing.",
      "required": [
        "id",
        "type",
        "task_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "task.release"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "page.snapshot": {
      "type": "object",
      "description": "The tab's page as accessibility nodes, bounded by mode, max_chars and depth.",
      "required": [
        "id",
        "type",
        "tab_id",
        "mode",
        "max_chars",
        "depth"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "page.snapshot"
        },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "mode": {
          "enum": [
            "interactive",
            "full"
          ]
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "page.screenshot": {
      "type": "object",
      "description": "Capture the tab as an image written exactly at path.",
      "required": [
        "id",
        "type",
        "tab_id",
        "full_page",
        "path"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "page.screenshot"
        },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "full_page": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        }
      },
      "additionalProperties": false
    },
    "page.pdf": {
      "type": "object",
      "description": "Print the tab to a PDF written exactly at path.",
      "required": [
        "id",
        "type",
        "tab_id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "page.pdf"
        },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        }
      },
      "additionalProperties": false
    },
    "page.act": {
      "type": "object",
      "description": "One interaction with the tab's page. ref is the element ref a node carried as backendDOMNodeId. With observe, carry the page back as `page` once the action settled.",
      "required": [
        "id",
        "type",
        "tab_id",
        "kind",
        "observe"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "page.act"
        },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "click",
            "fill",
            "fill_form",
            "type",
            "submit",
            "press",
            "hover",
            "get",
            "wait",
            "click_coords"
          ]
        },
        "observe": {
          "type": "boolean"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshotOptions"
        },
        "ref": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/formField"
          }
        },
        "field": {
          "enum": [
            "text",
            "title",
            "html",
            "count",
            "ready_state",
            "rect"
          ]
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "wait_until": {
          "enum": [
            "text",
            "url",
            "element",
            "load"
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "observe": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "snapshot"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "click",
                  "hover",
                  "submit"
                ]
              }
            }
          },
          "then": {
            "required": [
              "ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "fill",
                  "type"
                ]
              }
            }
          },
          "then": {
            "required": [
              "ref",
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fill_form"
              }
            }
          },
          "then": {
            "required": [
              "fields"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "press"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "click_coords"
              }
            }
          },
          "then": {
            "required": [
              "x",
              "y"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wait"
              }
            }
          },
          "then": {
            "required": [
              "wait_until",
              "timeout_ms"
            ]
          }
        }
      ]
    },
    "page.upload": {
      "type": "object",
      "description": "Put the file at path into the file input ref.",
      "required": [
        "id",
        "type",
        "tab_id",
        "ref",
        "path"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "page.upload"
        },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "ref": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        }
      },
      "additionalProperties": false
    },
    "dialog.resolve": {
      "type": "object",
      "description": "Answer the tab's open JavaScript dialog; text is a prompt's answer.",
      "required": [
        "id",
        "type",
        "tab_id",
        "accept"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "dialog.resolve"
        },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accept": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "additionalProperties": false
    },
    "cookies.get": {
      "type": "object",
      "description": "The cookies of the tab's site, metadata only, never a value.",
      "required": [
        "id",
        "type",
        "tab_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "type": {
          "const": "cookies.get"
        },
        "tab_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "cookies.clear": {
      "type": "object",
      "description": "Clear the cookies of the tab's site.",
      "required": [
        "id",
        "type",
        "tab_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
