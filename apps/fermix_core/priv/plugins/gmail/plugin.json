{
  "schema_version": 2,
  "name": "gmail",
  "display_name": "Gmail",
  "description": "Search mail, read message details, and optionally send messages.",
  "category": "productivity",
  "version": "1.0.0",
  "default_enabled": false,
  "interface": {
    "short_description": "Use Gmail from Fermix",
    "developer_name": "Fermix",
    "brand_color": "#EA4335",
    "icon": "assets/gmail-small.svg",
    "logo": "assets/gmail.png",
    "privacy_policy_url": "https://policies.google.com/privacy",
    "terms_of_service_url": "https://policies.google.com/terms"
  },
  "auth": {
    "type": "oauth2",
    "provider": "google",
    "profile_key": "gmail",
    "account_mode": "single",
    "scopes": [
      "openid",
      "email",
      "profile",
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/gmail.send",
      "https://www.googleapis.com/auth/gmail.compose",
      "https://www.googleapis.com/auth/gmail.modify"
    ]
  },
  "tools": [
    {
      "name": "gmail_search_messages",
      "description": "Search Gmail and return message summaries (sender, subject, date, snippet).",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "https://www.googleapis.com/auth/gmail.readonly"
      ]
    },
    {
      "name": "gmail_get_message",
      "description": "Fetch a single Gmail message's headers and body by id.",
      "policy_class": "external_api",
      "read_only": true,
      "requires_scopes": [
        "https://www.googleapis.com/auth/gmail.readonly"
      ]
    },
    {
      "name": "gmail_send_message",
      "description": "Send an email with Gmail.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "https://www.googleapis.com/auth/gmail.send"
      ]
    },
    {
      "name": "gmail_reply_to_thread",
      "description": "Reply within an existing Gmail thread.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "https://www.googleapis.com/auth/gmail.send"
      ]
    },
    {
      "name": "gmail_create_draft",
      "description": "Create a Gmail draft (does not send).",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "https://www.googleapis.com/auth/gmail.compose"
      ]
    },
    {
      "name": "gmail_send_draft",
      "description": "Send an existing Gmail draft by id.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "https://www.googleapis.com/auth/gmail.compose"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Draft id from gmail_create_draft."
          }
        },
        "required": [
          "id"
        ]
      },
      "request": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/drafts/send",
        "body": {
          "id": "{id}"
        },
        "success": [
          200,
          201,
          204
        ]
      }
    },
    {
      "name": "gmail_modify_message_labels",
      "description": "Add or remove labels on a message (mark read/unread, archive, star).",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "https://www.googleapis.com/auth/gmail.modify"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Message id."
          },
          "add_label_ids": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "Label ids to add; e.g. STARRED, UNREAD."
          },
          "remove_label_ids": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            },
            "description": "Label ids to remove; UNREAD marks read, INBOX archives."
          }
        },
        "required": [
          "id"
        ]
      },
      "request": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/{id}/modify",
        "body": {
          "addLabelIds": "{add_label_ids}",
          "removeLabelIds": "{remove_label_ids}"
        },
        "success": [
          200,
          201,
          204
        ]
      }
    },
    {
      "name": "gmail_trash_message",
      "description": "Move a Gmail message to Trash.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "https://www.googleapis.com/auth/gmail.modify"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Message id."
          }
        },
        "required": [
          "id"
        ]
      },
      "request": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/{id}/trash",
        "success": [
          200,
          201,
          204
        ]
      }
    },
    {
      "name": "gmail_untrash_message",
      "description": "Restore a Gmail message from Trash.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "https://www.googleapis.com/auth/gmail.modify"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Message id."
          }
        },
        "required": [
          "id"
        ]
      },
      "request": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/{id}/untrash",
        "success": [
          200,
          201,
          204
        ]
      }
    },
    {
      "name": "gmail_create_label",
      "description": "Create a Gmail label.",
      "policy_class": "external_api",
      "read_only": false,
      "requires_scopes": [
        "https://www.googleapis.com/auth/gmail.modify"
      ],
      "rail": "http",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Label name; use '/' for nesting."
          },
          "label_list_visibility": {
            "type": "string",
            "description": "labelShow | labelShowIfUnread | labelHide."
          },
          "message_list_visibility": {
            "type": "string",
            "description": "show | hide."
          }
        },
        "required": [
          "name"
        ]
      },
      "request": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/labels",
        "body": {
          "name": "{name}",
          "labelListVisibility": "{label_list_visibility}",
          "messageListVisibility": "{message_list_visibility}"
        },
        "success": [
          200,
          201,
          204
        ]
      }
    }
  ],
  "skills": [
    {
      "name": "gmail-plugin",
      "path": "skills/gmail/SKILL.md"
    }
  ],
  "health_check": {
    "kind": "local_readiness",
    "requires_auth": true
  },
  "plugin_api": 2,
  "min_core_version": "0.4.0"
}
