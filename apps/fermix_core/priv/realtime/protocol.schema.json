{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fermix.sh/realtime/protocol.schema.json",
  "title": "Fermix Realtime voice socket protocol",
  "description": "Newline-delimited JSON wire contract between the Fermix daemon and the FermixPet companion. Source of truth: FermixCore.Realtime.Protocol. See PROTOCOL.md.",
  "x-protocol-version": 2,
  "x-supported-version-range": { "min": 1, "max": 2 },
  "$defs": {
    "clientEvent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "client_hello",
            "call_start",
            "audio_chunk",
            "interrupt",
            "mute",
            "call_stop",
            "task_cancel"
          ]
        }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "client_hello" } } },
          "then": { "$ref": "#/$defs/client_hello" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "audio_chunk" } } },
          "then": { "$ref": "#/$defs/audio_chunk" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "interrupt" } } },
          "then": { "$ref": "#/$defs/interrupt" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "task_cancel" } } },
          "then": { "$ref": "#/$defs/task_cancel" }
        }
      ]
    },
    "serverEvent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "server_hello",
            "state",
            "audio_delta",
            "transcript_delta",
            "assistant_text_delta",
            "tool_event",
            "usage",
            "error",
            "playback_stop",
            "call_ready",
            "caption",
            "task"
          ]
        }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "server_hello" } } },
          "then": { "$ref": "#/$defs/server_hello" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "error" } } },
          "then": { "$ref": "#/$defs/error" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "call_ready" } } },
          "then": { "$ref": "#/$defs/call_ready" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "caption" } } },
          "then": { "$ref": "#/$defs/caption" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "task" } } },
          "then": { "$ref": "#/$defs/task" }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "usage" } } },
          "then": { "$ref": "#/$defs/usage" }
        }
      ]
    },
    "client_hello": {
      "type": "object",
      "required": ["type", "protocol_version"],
      "properties": {
        "type": { "const": "client_hello" },
        "protocol_version": { "type": "integer", "minimum": 1 }
      }
    },
    "audio_chunk": {
      "type": "object",
      "required": ["type", "audio"],
      "properties": {
        "type": { "const": "audio_chunk" },
        "audio": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "interrupt": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "interrupt" },
        "audio_end_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "task_cancel": {
      "type": "object",
      "description": "Cancels one backend delegation of a Live call. Refused with error(unsupported_by_engine) under the Realtime engine.",
      "required": ["type", "delegation_id"],
      "properties": {
        "type": { "const": "task_cancel" },
        "delegation_id": { "type": "string", "minLength": 1 }
      }
    },
    "server_hello": {
      "type": "object",
      "required": ["type", "min_version", "max_version"],
      "properties": {
        "type": { "const": "server_hello" },
        "min_version": { "type": "integer", "minimum": 1 },
        "max_version": { "type": "integer", "minimum": 1 }
      }
    },
    "call_ready": {
      "type": "object",
      "description": "The provider session is established and the call can carry audio.",
      "required": ["type", "engine", "call_id", "captions"],
      "properties": {
        "type": { "const": "call_ready" },
        "engine": { "enum": ["openai_realtime", "openai_live"] },
        "call_id": { "type": "string", "minLength": 1 },
        "provider_session_id": { "type": "string" },
        "expires_at": {
          "type": "integer",
          "description": "Unix seconds at which the provider session expires; absent when unknown."
        },
        "captions": {
          "type": "boolean",
          "description": "True when caption frames will be sent for this call."
        }
      }
    },
    "caption": {
      "type": "object",
      "description": "One verbatim transcript fragment. Concatenate deltas without trimming or inserting spaces.",
      "required": ["type", "speaker", "delta", "start_ms", "end_ms"],
      "properties": {
        "type": { "const": "caption" },
        "speaker": { "enum": ["user", "assistant"] },
        "delta": { "type": "string" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "task": {
      "type": "object",
      "description": "Lifecycle of one backend delegation. revision fences a re-asked task.",
      "required": ["type", "delegation_id", "revision", "status"],
      "properties": {
        "type": { "const": "task" },
        "delegation_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["pending", "running", "completed", "failed", "cancelled"] },
        "summary": { "type": "string", "maxLength": 240 }
      }
    },
    "usage": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "usage" },
        "status": { "type": "string" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "voice_seconds": { "type": "number" },
        "voice_cost_cents": { "type": "number" },
        "backend_turns": { "type": "integer" },
        "backend_cost": { "const": "unknown" },
        "accounting": { "enum": ["complete", "incomplete", "running"] }
      }
    },
    "error": {
      "type": "object",
      "required": ["type", "reason"],
      "properties": {
        "type": { "const": "error" },
        "reason": { "type": "string" },
        "kind": {
          "enum": [
            "update_required",
            "provider_refused",
            "cost_limit",
            "session_expired",
            "close_timeout",
            "bridge_unavailable",
            "max_session_duration",
            "provider_disconnected"
          ]
        },
        "detail": {
          "type": "string",
          "description": "The vendor's own sentence, bounded. Present when the provider explained the failure."
        },
        "required_for": {
          "enum": ["openai_live"],
          "description": "On update_required: the engine that needs the higher protocol version."
        },
        "direction": { "enum": ["client_too_old", "client_too_new"] },
        "client_version": { "type": "integer" },
        "min_version": { "type": "integer" },
        "max_version": { "type": "integer" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/clientEvent" },
    { "$ref": "#/$defs/serverEvent" }
  ]
}
