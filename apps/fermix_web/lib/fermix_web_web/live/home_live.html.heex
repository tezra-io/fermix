<Layouts.flash_group flash={@flash} />
<% snapshot_ready? = @home.status == :ok %>
<% data = if snapshot_ready?, do: @home.data, else: %{} %>
<% overview = Map.get(data, :overview, %{}) %>
<% agents = Map.get(data, :agents, %{}) %>
<% jobs =
  Map.get(data, :jobs, %{
    status: :unavailable,
    error: "snapshot unavailable",
    counts: %{},
    jobs: []
  }) %>
<% realtime = Map.get(overview, :realtime, %{enabled: false, status: :unknown}) %>
<% realtime_enabled? = Map.get(realtime, :enabled) == true %>
<% realtime_status = Map.get(realtime, :status, :unknown) %>
<% realtime_companion? = Map.get(realtime, :companion_connected?) == true %>
<% realtime_badge_class =
  case realtime_status do
    :ready -> "badge badge-success"
    :degraded -> "badge badge-warning"
    :setup_required -> "badge badge-warning"
    :disabled -> "badge badge-outline"
    _ -> "badge badge-ghost"
  end %>
<% main_agent = get_in(agents, [:main]) || %{} %>
<% workers = Map.get(agents, :skill_workers, []) %>
<% agent_counts = Map.get(agents, :counts, %{}) %>
<% job_counts = Map.get(jobs, :counts, %{}) %>
<% provider = Map.get(main_agent, :provider) || get_in(overview, [:provider, :active]) %>
<% model = Map.get(main_agent, :model) || get_in(overview, [:provider, :model]) %>
<% main_health = Map.get(main_agent, :health) || get_in(overview, [:agents, :main, :health]) %>
<% main_activity =
  Map.get(main_agent, :activity) || get_in(overview, [:agents, :main, :activity]) ||
    Map.get(main_agent, :status) || get_in(overview, [:agents, :main, :status]) %>
<main class="min-h-screen bg-base-100 text-base-content">
  <section class="border-b border-base-300 bg-base-200/60">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-base-content/60">Fermix</p>
        <h1 class="mt-1 text-xl font-semibold leading-7 sm:text-2xl">Agent runtime ready</h1>
      </div>
      <Layouts.theme_toggle />
    </div>
  </section>

  <section class="mx-auto max-w-6xl space-y-8 px-5 py-8 sm:px-8">
    <div class="grid gap-8 lg:grid-cols-[1.35fr_0.65fr]">
      <div class="space-y-8">
        <div class="border-l-4 border-primary pl-5">
          <p class="text-3xl font-semibold leading-tight sm:text-4xl">
            Fermix is configured and accepting runtime traffic.
          </p>
          <p class="mt-4 max-w-2xl text-base leading-7 text-base-content/70">
            Runtime state below comes from the same read-only introspection snapshot used by
            the CLI and upcoming dashboard views.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-3">
          <a class="btn btn-primary justify-start" href={~p"/setup"}>
            <.icon name="hero-wrench-screwdriver" class="size-5" /> Open setup
          </a>
          <a class="btn btn-outline justify-start" href={~p"/health/ready?pretty=1"}>
            <.icon name="hero-check-circle" class="size-5" /> Readiness
          </a>
          <a class="btn btn-outline justify-start" href={~p"/health/live?pretty=1"}>
            <.icon name="hero-signal" class="size-5" /> Liveness
          </a>
        </div>
      </div>

      <aside class="border border-base-300 bg-base-100 p-5 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/60">
          Runtime
        </h2>
        <dl class="mt-5 space-y-4 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="text-base-content/60">Boot state</dt>
            <dd class="badge badge-success gap-2">
              <span class="h-2 w-2 rounded-full bg-current"></span> ready
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-base-content/60">Readiness</dt>
            <dd class="font-medium">{status_label(get_in(overview, [:readiness, :status]))}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-base-content/60">Main agent</dt>
            <dd class="font-medium">
              {status_label(main_health)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-base-content/60">Scheduled jobs</dt>
            <dd class="font-medium">{Map.get(job_counts, :total, 0)}</dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-base-content/60">Realtime voice</dt>
            <dd class={realtime_badge_class <> " gap-2"}>
              <span class="h-2 w-2 rounded-full bg-current"></span>
              {status_label(realtime_status)}
            </dd>
          </div>
        </dl>
      </aside>
    </div>

    <%= if snapshot_ready? do %>
      <section class="grid gap-6 lg:grid-cols-2">
        <div class="border border-base-300 bg-base-100 p-5 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold">Main agent</h2>
              <p class="mt-1 text-sm text-base-content/60">
                {Map.get(main_agent, :name) || "main"}
              </p>
            </div>
            <span class="badge badge-success">{status_label(main_health)}</span>
          </div>

          <dl class="mt-5 grid grid-cols-2 gap-4 text-sm">
            <div>
              <dt class="text-base-content/60">Health</dt>
              <dd class="mt-1 font-medium">{status_label(main_health)}</dd>
            </div>
            <div>
              <dt class="text-base-content/60">Activity</dt>
              <dd class="mt-1 font-medium">{status_label(main_activity)}</dd>
            </div>
            <div>
              <dt class="text-base-content/60">Active requests</dt>
              <dd class="mt-1 text-xl font-semibold">
                {Map.get(
                  main_agent,
                  :active_requests,
                  Map.get(main_agent, :active_conversations, 0)
                )}
              </dd>
            </div>
            <div>
              <dt class="text-base-content/60">Pending requests</dt>
              <dd class="mt-1 text-xl font-semibold">
                {Map.get(
                  main_agent,
                  :pending_requests,
                  Map.get(main_agent, :pending_conversations, 0)
                )}
              </dd>
            </div>
            <div>
              <dt class="text-base-content/60">Provider</dt>
              <dd class="mt-1 font-medium">{status_label(provider)}</dd>
            </div>
            <div>
              <dt class="text-base-content/60">Model</dt>
              <dd class="mt-1 font-medium">{model || "unknown"}</dd>
            </div>
          </dl>
        </div>

        <div class="border border-base-300 bg-base-100 p-5 shadow-sm">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold">Subagents</h2>
              <p class="mt-1 text-sm text-base-content/60">
                {Map.get(agent_counts, :running_skill_workers, 0)} running of {Map.get(
                  agent_counts,
                  :skill_workers,
                  length(workers)
                )}
              </p>
            </div>
            <span class="badge badge-outline">{length(workers)}</span>
          </div>

          <div class="mt-5 divide-y divide-base-300">
            <%= if workers == [] do %>
              <p class="py-4 text-sm text-base-content/60">No subagents active.</p>
            <% else %>
              <%= for worker <- workers do %>
                <div class="flex items-center justify-between gap-4 py-3 text-sm">
                  <div>
                    <p class="font-medium">{Map.get(worker, :name) || "unnamed"}</p>
                    <p class="mt-1 text-base-content/60">
                      {status_label(Map.get(worker, :role))} · {Map.get(worker, :session_id) ||
                        "no session"}
                    </p>
                  </div>
                  <span class="badge badge-outline">
                    {status_label(Map.get(worker, :status))}
                  </span>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </section>

      <section class="border border-base-300 bg-base-100 p-5 shadow-sm">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2 class="text-lg font-semibold">Realtime voice</h2>
            <p class="mt-1 text-sm text-base-content/60">
              <%= if realtime_enabled? do %>
                {Map.get(realtime, :provider) || "openai"} · {Map.get(realtime, :model) ||
                  "unknown"}
              <% else %>
                Disabled — enable in setup to use FermixPet
              <% end %>
            </p>
          </div>
          <span class={realtime_badge_class}>{status_label(realtime_status)}</span>
        </div>

        <%= if realtime_enabled? do %>
          <dl class="mt-5 grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
            <div>
              <dt class="text-base-content/60">Companion</dt>
              <dd class="mt-1 font-medium">
                <%= if realtime_companion? do %>
                  <span class="badge badge-success badge-sm">connected</span>
                <% else %>
                  <span class="badge badge-ghost badge-sm">idle</span>
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="text-base-content/60">Active sessions</dt>
              <dd class="mt-1 text-xl font-semibold">{Map.get(realtime, :active_sessions, 0)}</dd>
            </div>
            <div>
              <dt class="text-base-content/60">Active clients</dt>
              <dd class="mt-1 text-xl font-semibold">{Map.get(realtime, :active_clients, 0)}</dd>
            </div>
            <div>
              <dt class="text-base-content/60">Socket</dt>
              <dd class="mt-1 font-medium">
                <%= if Map.get(realtime, :socket_alive) == true do %>
                  <span class="badge badge-success badge-sm">alive</span>
                <% else %>
                  <span class="badge badge-error badge-sm">down</span>
                <% end %>
              </dd>
            </div>
          </dl>

          <%= if path = Map.get(realtime, :socket_path) do %>
            <p class="mt-4 truncate text-xs text-base-content/50">
              <span class="text-base-content/40">socket</span> <code class="ml-1">{path}</code>
            </p>
          <% end %>
        <% end %>
      </section>

      <section class="border border-base-300 bg-base-100 p-5 shadow-sm">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2 class="text-lg font-semibold">Scheduled jobs</h2>
            <p class="mt-1 text-sm text-base-content/60">
              {Map.get(job_counts, :scheduled, 0)} scheduled · {Map.get(job_counts, :running, 0)} running · {Map.get(
                job_counts,
                :paused,
                0
              )} paused
            </p>
          </div>
          <span class="badge badge-outline">{status_label(Map.get(jobs, :status))}</span>
        </div>

        <%= if Map.get(jobs, :status) == :ready do %>
          <div class="mt-5 overflow-x-auto">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>State</th>
                  <th>Schedule</th>
                  <th>Next run</th>
                  <th>Last status</th>
                  <th>Delivery</th>
                </tr>
              </thead>
              <tbody>
                <%= if Map.get(jobs, :jobs, []) == [] do %>
                  <tr>
                    <td colspan="6" class="py-6 text-center text-base-content/60">
                      No scheduled jobs.
                    </td>
                  </tr>
                <% else %>
                  <%= for job <- Map.get(jobs, :jobs, []) do %>
                    <tr>
                      <td>
                        <div class="font-medium">{Map.get(job, :name) || Map.get(job, :id)}</div>
                        <div class="text-xs text-base-content/50">{Map.get(job, :id)}</div>
                      </td>
                      <td>{status_label(Map.get(job, :state))}</td>
                      <td>{Map.get(job, :schedule_expr) || "unknown"}</td>
                      <td>{datetime_label(Map.get(job, :next_run_at))}</td>
                      <td>{status_label(Map.get(job, :last_status))}</td>
                      <td>{status_label(Map.get(job, :delivery_mode))}</td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="mt-5 text-sm text-error">
            Scheduled jobs unavailable: {Map.get(jobs, :error) || "unknown"}
          </p>
        <% end %>
      </section>
    <% else %>
      <section class="border border-error/40 bg-error/5 p-5 text-error">
        <h2 class="text-lg font-semibold">Runtime snapshot unavailable</h2>
        <p class="mt-2 text-sm">{@home.reason}</p>
      </section>
    <% end %>
  </section>
</main>
