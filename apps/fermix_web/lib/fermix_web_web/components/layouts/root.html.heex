<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Fermix" suffix=" · Operator Console">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        // Embedded in the macOS app: ignore any stored theme choice and keep
        // data-theme off, so daisyUI's prefersdark theme follows
        // prefers-color-scheme, which WKWebView derives from the app's
        // appearance. The in-page toggle is not rendered in embed, so the pane
        // can never diverge from the app. data-embed also goes on the root
        // element here: the document is the scroller, so the scrollbar-hiding
        // CSS must match <html> itself, not only descendants of <main>.
        if (new URLSearchParams(location.search).has("embed")) {
          document.documentElement.setAttribute("data-embed", "");
          document.documentElement.removeAttribute("data-theme");
          return;
        }
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
