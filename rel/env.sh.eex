#!/bin/sh
# The daemon is a single node: it never clusters, so Erlang distribution stays
# off. Leaving the mix-release default (sname = release name) on would register
# every engine with epmd under one fixed name — two engines on a machine then
# collide ("name fermix_app_engine seems to be in use", observed live
# 2026-08-21 during the M34 agent smoke), and every install would carry an
# open distribution listener it has no use for. The Burrito standalone never
# reads this script (its wrapper boots ERTS directly, distribution already
# off); this pins the plain app-engine release to the same posture.
# Consequence: the generated release's rpc commands (`stop`, `remote`, `rpc`)
# cannot reach a distribution-less node. The sanctioned stop is the management
# lifecycle (scripts/dev/engine_stop.py locally; lifecycle.prepare/commit from
# the app), which is also what the release verifier smokes.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
