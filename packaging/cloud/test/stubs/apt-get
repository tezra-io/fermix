#!/bin/sh
# Test stand-in for apt-get: logs the call and installs nothing, except that
# installing chromium leaves an executable /usr/bin/chromium, as the package
# does, for the first boot's check, installing tailscale puts the tailscale
# stand-in where the package puts the real one, and a local package (a path
# ending .deb: the Fermix package first boot and the update install, built
# by in_container.sh) is installed by the real dpkg, its work directory
# logged as WORK/. An install prints the lines dpkg prints for each package,
# which -qq does not quiet, and fails as apt-get does, with its own message,
# when it names the package in /etc/fermix-test/apt-fails (fermix for the
# local package).
set -eu
printf 'apt-get %s\n' "$*" | sed 's|/run/fermix-[a-z-]*\.[A-Za-z0-9]*/|WORK/|g' >>/var/log/fermix-test/calls.log
case " $* " in
  *" install "*) ;;
  *) exit 0 ;;
esac
for package in "$@"; do
  case "$package" in -* | install) continue ;; esac
  name=$package
  case "$package" in *.deb) name=fermix ;; esac
  if [ -f /etc/fermix-test/apt-fails ] && [ "$name" = "$(cat /etc/fermix-test/apt-fails)" ]; then
    echo "E: Unable to locate package $name" >&2
    exit 100
  fi
  case "$package" in
    *.deb)
      dpkg -i "$package"
      continue
      ;;
  esac
  printf 'Selecting previously unselected package %s.\n' "$package"
  printf 'Preparing to unpack .../%s_1.0_arm64.deb ...\n' "$package"
  printf 'Unpacking %s (1.0) ...\n' "$package"
  printf 'Setting up %s (1.0) ...\n' "$package"
done
case " $* " in
  *" chromium "*) printf '#!/bin/sh\nexit 0\n' >/usr/bin/chromium && chmod 0755 /usr/bin/chromium ;;
  *" tailscale "*) install -m 0755 /cloud/test/stubs/tailscale /usr/bin/tailscale ;;
esac
