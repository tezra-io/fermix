#!/bin/sh
# Test stand-in for dpkg-query: the version of fermix the stand-in package
# installed last (its postinst records it), as `-W -f='${Version}' fermix`
# prints it, or not installed before it ran. Logs nothing, as a read.
set -eu
version=/var/lib/fermix-test/installed-version
[ -f "$version" ] || exit 1
tr -d '\n' <"$version"
