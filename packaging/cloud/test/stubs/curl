#!/bin/sh
# Test stand-in for curl. https://fermix.ai/install answers the fake
# installer, unless /etc/fermix-test/install-unreachable exists;
# https://fermix.ai/install/releases answers /etc/fermix-test/releases and a
# release file on GitHub answers /etc/fermix-test/release/v<version>/<file>,
# each a 404 while the file is not there (what the regular installer's
# --always-on fetches); https://pkgs.tailscale.com/ is fetched for real, with
# the curl the tailnet scenario installs; any other address is refused, as
# one that does not resolve is. Logs every call as a GET of its URL.
set -eu
log=/var/log/fermix-test
url="" out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out=$2; shift 2 ;;
    --proto) shift 2 ;;
    http://* | https://*) url=$1; shift ;;
    --*) echo "curl stand-in: unexpected option $1" >&2; exit 2 ;;
    -*) shift ;;
    *) echo "curl stand-in: unexpected argument" >&2; exit 2 ;;
  esac
done
printf 'curl GET %s\n' "$url" >>"$log/calls.log"

[ ! -f /etc/fermix-test/install-unreachable ] || exit 6
case "$url" in
  https://fermix.ai/install) body=/cloud/test/fake-install.sh ;;
  https://fermix.ai/install/releases) body=/etc/fermix-test/releases ;;
  https://github.com/tezra-io/fermix/releases/download/*)
    body=/etc/fermix-test/release/${url#https://github.com/tezra-io/fermix/releases/download/}
    ;;
  https://pkgs.tailscale.com/*) exec /usr/bin/curl -fsSL --proto '=https' "$url" -o "$out" ;;
  *) exit 6 ;;
esac
[ -f "$body" ] || exit 22
if [ -n "$out" ]; then cat "$body" >"$out"; else cat "$body"; fi
