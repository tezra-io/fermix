#compdef fermix
# zsh completion for fermix, installed by the fermix package.
# The verb list is the one `fermix help` prints; a test keeps them in step.

_fermix_verbs=(setup auth ask chat run sandbox grant revoke service start stop restart status health voice acp browser browser-bridge agents capabilities skills plugins pair devices settings memory logs upgrade uninstall migrate-to-app doctor diagnostics version help)

_fermix() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1:command:->command' \
    '*::arguments:->arguments'

  case $state in
    command)
      _describe -t commands 'fermix command' _fermix_verbs
      ;;
    arguments)
      case $words[1] in
        setup)
          _values 'option' '--web' '--cli' '--terminal' '--no-browser' '--no-service' \
            '--user' '--system' '--rotate-token' '--print-state' '--reconfigure' \
            '--migrate-secrets' '--secret-store' '--import-codex' '--provider' '--default-model' \
            '--reasoning-effort' '--fast' '--no-fast'
          ;;
        auth)
          _values 'subcommand' 'login' 'status' 'logout' '--no-browser' '--port' '--timeout'
          ;;
        ask|chat)
          _values 'option' '--stdin' '--session' '--timeout' '--json'
          ;;
        service)
          _values 'subcommand' 'install' 'uninstall' 'status' 'run' \
            '--json' '--home' '--port' '--user' '--system'
          ;;
        start|stop)
          _values 'option' '--user' '--system'
          ;;
        restart)
          _values 'option' '--json' '--when-idle' '--user' '--system'
          ;;
        status)
          _values 'option' '--full' '--json'
          ;;
        health|agents|voice)
          _values 'option' '--json'
          ;;
        acp)
          _values 'subcommand' 'forget' '--all'
          ;;
        browser)
          _values 'subcommand' 'bridge' 'install' 'uninstall' 'status' '--browser' '--extension-id'
          ;;
        browser-bridge)
          _values 'option' '--manifest'
          ;;
        capabilities)
          _values 'option' '--kind' '--json'
          ;;
        skills)
          _values 'subcommand' 'list' 'view' 'reload' '--json'
          ;;
        plugins)
          _values 'subcommand' 'list' 'catalog' 'install' 'enable' 'disable' 'auth' '--json'
          ;;
        devices)
          _values 'subcommand' 'list' 'revoke'
          ;;
        settings)
          if (( CURRENT == 2 )); then
            _values 'subcommand' 'list' 'show' 'set' 'secret' 'primary' 'reload' '--json'
          elif [[ $words[2] == secret ]] && (( CURRENT == 3 )); then
            _values 'subcommand' 'set' 'clear'
          elif [[ $words[2] == show ]]; then
            _values 'option' '--json' '--info'
          elif [[ $words[2] == secret && $words[3] == set ]]; then
            _values 'option' '--json' '--stdin'
          else
            _values 'option' '--json'
          fi
          ;;
        memory)
          _values 'subcommand' 'review' 'restore' '--now' '--conversation' '--json'
          ;;
        logs)
          _values 'option' '-f' '-n'
          ;;
        upgrade)
          _values 'option' '--check'
          ;;
        migrate-to-app)
          _values 'option' '--yes'
          ;;
        doctor)
          _values 'option' '--full'
          ;;
        diagnostics)
          _values 'option' 'export' '--offline' '--json'
          ;;
      esac
      ;;
  esac
}

_fermix "$@"
