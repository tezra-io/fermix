# nFPM configuration for the `fermix` engine package (M38 §2.2).
#
# Rendered by scripts/release/linux_packages.py, which fills every placeholder
# below and refuses to leave one behind. One rendered file produces both the
# deb and the rpm, so the two families cannot drift into two file lists.
#
# The version is the tag's, exactly: `version_schema: none` keeps nFPM from
# reshaping it, and `release` is left empty so the Debian version carries no
# revision. nFPM's rpm packager defaults an empty release to "1", which is the
# RPM `Release` tag; `Requires: fermix = <version>` is version-only and matches
# any release, so both spellings of the desktop package's exact-version
# relation still mean the same thing. A packaging-only fix is published as the
# next version, never as a revision of this one.
#
# No dependencies are declared: the wrapper carries its own musl-linked ERTS
# with static OpenSSL and links nothing from the host (M38 §12.1).
name: fermix
arch: {{ARCH}}
platform: linux
version: "{{VERSION}}"
version_schema: none
release: ""
maintainer: Tezra <hello@fermix.ai>
description: |
  Elixir-native multi-agent AI platform.
  Fermix runs a personal AI daemon on this machine: agents, providers, tools
  and memory in one supervised process, reachable from the terminal, from chat
  channels and from the setup page it serves.
homepage: https://fermix.ai
license: MIT
section: utils
priority: optional

contents:
  - src: {{STAGE}}/usr/bin/fermix
    dst: /usr/bin/fermix
    file_info:
      mode: 0755

  - src: {{STAGE}}/usr/lib/fermix/cosign
    dst: /usr/lib/fermix/cosign
    file_info:
      mode: 0755

  # The verified loader input. The package configuration step materialises it
  # into /var/lib/fermix/runtimes/<digest>/libc-musl.so, which is the address
  # every packaged ELF interpreter names.
  - src: {{STAGE}}/usr/lib/fermix/runtime-payload/{{LOADER}}
    dst: /usr/lib/fermix/runtime-payload/{{LOADER}}
    file_info:
      mode: 0644

  - src: {{STAGE}}/usr/lib/systemd/user/fermix.service
    dst: /usr/lib/systemd/user/fermix.service
    file_info:
      mode: 0644

  - src: {{STAGE}}/usr/share/fermix/engine.json
    dst: /usr/share/fermix/engine.json
    file_info:
      mode: 0644

  - src: {{STAGE}}/usr/share/bash-completion/completions/fermix
    dst: /usr/share/bash-completion/completions/fermix
    file_info:
      mode: 0644

  - src: {{STAGE}}/usr/share/zsh/site-functions/_fermix
    dst: /usr/share/zsh/site-functions/_fermix
    file_info:
      mode: 0644

  - src: {{STAGE}}/usr/share/fish/vendor_completions.d/fermix.fish
    dst: /usr/share/fish/vendor_completions.d/fermix.fish
    file_info:
      mode: 0644

  - src: {{STAGE}}/usr/share/man/man1/fermix.1.gz
    dst: /usr/share/man/man1/fermix.1.gz
    file_info:
      mode: 0644

  - src: {{STAGE}}/usr/share/doc/fermix/copyright
    dst: /usr/share/doc/fermix/copyright
    file_info:
      mode: 0644

  - src: {{STAGE}}/usr/share/doc/fermix/changelog.Debian.gz
    dst: /usr/share/doc/fermix/changelog.Debian.gz
    file_info:
      mode: 0644

scripts:
  postinstall: {{POSTINSTALL}}
  postremove: {{POSTREMOVE}}
