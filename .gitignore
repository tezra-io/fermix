# Elixir
/_build/
/deps/
/burrito_out/
# No lock file exclusion — mix.lock must be committed for reproducible builds

# Mix release runtime templates (rel/*.eex): unmodified `mix release.init`
# scaffold. `mix release` falls back to identical built-in defaults when absent,
# so they change nothing in the build. Regenerate with `mix release.init` if VM
# boot ever needs customizing (e.g. heart/daemon auto-restart in env.sh.eex).
/rel/

# Umbrella apps
/apps/*/deps/
/apps/*/_build/

# Phoenix
/apps/fermix_web/priv/static/assets/
/apps/fermix_web/priv/static/cache_manifest.json
/apps/fermix_web/priv/static/**/*.gz
/apps/fermix_web/priv/static/favicon-*.ico
/apps/fermix_web/priv/static/favicon-*.png
/apps/fermix_web/priv/static/robots-*.txt
/apps/fermix_web/priv/static/images/*-*.svg

# Rustler
/apps/fermix_nif/native/fermix_nif/target/

# SwiftPM macOS clients
/clients/macos/*/.build/
/clients/macos/*/.swiftpm/

# Environment
.env
*.secret.exs

# Fermix runtime config, secrets & data (written under FERMIX_HOME — never commit)
config.toml
auth.json
.fermix/
.fermix-dev/
*.db
*.sqlite
*.sqlite3
*.log

# Local keychain-migration helper (machine-specific; not part of the repo)
/scripts/migrate-keychain-scope.sh

# IDE
.elixir_ls/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test
/cover/
/apps/*/cover/
erl_crash.dump

# docs/ — track markdown design docs, PNGs, and the superpowers/ subdirectory;
# ignore generated artifacts (HTML renders, other binaries, etc.).
/docs/*
!/docs/*.md
!/docs/*.png
/docs/superpowers/
docs/design/
# Release film working files (brief, mascot/wordmark assets, motion proof, Figma exports)
/docs/release-film/

# Claude Code local worktrees
/.claude/worktrees/
.claude/
# Transient benchmark outputs (track only bench/baseline.json once it lands)
/bench/current.json
/bench/soak.json

#Logs
.playwright-mcp/

#.agents
.agents/skills/.venv/
.agents/skills/bin/
.agents/skills/reports/__pycache__/

# Python bytecode (release scripts)
__pycache__/
*.pyc
