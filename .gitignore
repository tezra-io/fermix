.elixir_ls/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test
/cover/
/apps/*/cover/
erl_crash.dump

# docs/ — track markdown design docs and the superpowers/ subdirectory;
# ignore generated artifacts (HTML renders, exported images, etc.).
/docs/*
!/docs/*.md
!/docs/superpowers/